{
  "name": "asciidoctor-docs-netlify",
  "description": "Asciidoctor Docs (Production and Deploy Previews)",
  "private": true,
  "devDependencies": {
    "@asciidoctor/tabs": "1.0.0-beta.6",
    "antora": "latest",
    "@antora/pdf-extension": "latest"
  },
  "scripts": {
    "reinstall": "rm -rf package-lock.json node_modules && npm i --omit=optional",
    "postinstall": "npm i --no-package-lock --prefix checklinks git+https://github.com/mojavelinux/netlify-plugin-checklinks.git#patched"
  }
}
